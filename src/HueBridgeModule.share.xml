                <ParameterRefRef RefId="%AID%_P-1400001_R-140000101" />
                
                <!-- Hinweistext je nach Auswahlmethode -->
                <choose ParamRefId="%AID%_P-1400001_R-140000101">
                  <when test="0"> <!-- Automatisch (mDNS) -->
                    <ParameterSeparator Id="%AID%_PS-HUEAutoInfo" Text="ERSTINBETRIEBNAHME (Automatische Bridge-Erkennung):&#xA;&#xA;1. Konfiguration per ETS-Download auf das Gerät laden&#xA;2. Gerät startet neu und sucht die Hue Bridge im Netzwerk&#xA;3. Pairing starten: ETS KO 'Pairing Trigger' auf 1 senden&#xA;4. Link-Button an der Hue Bridge innerhalb des Pairing-Fensters drücken&#xA;5. Status-KO zeigt 'Verbunden', Info LED 1 leuchtet dauerhaft&#xA;&#xA;LED-SIGNALE (INFO LED 1):&#xA;• Schnelles Blinken: Sucht/Authentifiziert&#xA;• Pulsieren: Wartet auf Link-Button&#xA;• Dauerhaft an: Verbunden und betriebsbereit&#xA;• Langsames Blinken: Keine Verbindung" UIHint="Information" />
                  </when>
                  <when test="1"> <!-- Manuelle IP -->
                    <ParameterRefRef RefId="%AID%_P-1400002_R-140000201" />
                    <ParameterSeparator Id="%AID%_PS-HUEManualInfo" Text="ERSTINBETRIEBNAHME (Manuelle IP-Adresse):&#xA;&#xA;1. IP-Adresse der Hue Bridge eintragen (z.B. 192.168.1.100)&#xA;2. Konfiguration per ETS-Download auf das Gerät laden&#xA;3. Gerät startet neu und verbindet sich mit der eingegebenen IP-Adresse&#xA;4. Pairing starten: ETS KO 'Pairing Trigger' auf 1 senden&#xA;5. Link-Button an der Hue Bridge innerhalb des Pairing-Fensters drücken&#xA;6. Status-KO zeigt 'Verbunden', Info LED 1 leuchtet dauerhaft&#xA;&#xA;LED-SIGNALE (INFO LED 1):&#xA;• Schnelles Blinken: Sucht/Authentifiziert&#xA;• Pulsieren: Wartet auf Link-Button&#xA;• Dauerhaft an: Verbunden und betriebsbereit&#xA;• Langsames Blinken: Keine Verbindung" UIHint="Information" />
                  </when>
                </choose>
                
                <ParameterRefRef RefId="%AID%_P-1400003_R-140000301" />
                <ParameterRefRef RefId="%AID%_P-1400006_R-140000601" />
                <ParameterRefRef RefId="%AID%_P-1400007_R-140000701" />
                
                <!-- Status-KO nur anzeigen wenn aktiviert -->
                <choose ParamRefId="%AID%_P-1400006_R-140000601">
